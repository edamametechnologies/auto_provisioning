<?xml version="1.0" encoding="utf-8"?>
<!-- Managed settings for the EDAMAME Security app. Requires EDAMAME >= 2.0.2. -->
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>EDAMAME Security</displayName>
  <description>Managed settings for the EDAMAME Security app.</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_EDAMAME_2_0_2">EDAMAME Security 2.0.2 or later</string>
      <string id="SUPPORTED_EDAMAME_2_0_5">EDAMAME Security 2.0.5 or later</string>
      <string id="EDAMAME">EDAMAME</string>
      <string id="EDAMAMESecurity">EDAMAME Security</string>
      <string id="OrganizationName">Organization name</string>
      <string id="OrganizationName_Help">Name shown in the app's &quot;Managed by your organization&quot; banner.</string>
      <string id="HubEmail">EDAMAME Hub account</string>
      <string id="HubEmail_Help">Hub account as user@domain. Use HubEmailSource=upn instead when every device should enroll with the signed-in user's UPN.</string>
      <string id="LLMModel">LLM model</string>
      <string id="LLMModel_Help">Model for Claude, OpenAI or Ollama. Ignored for the EDAMAME Portal, which chooses its model.</string>
      <string id="LLMBaseURL">LLM base URL</string>
      <string id="LLMBaseURL_Help">Ollama URL, or an API base URL for Claude / OpenAI.</string>
      <string id="LockHubEnrollment">Lock Hub enrollment</string>
      <string id="LockHubEnrollment_Help">The user cannot change or disconnect the Hub account. Without the lock, the account is a default: applied when the policy value is new or changes, and the user may change it.</string>
      <string id="LockLLM">Lock LLM configuration</string>
      <string id="LockLLM_Help">The user cannot change the values this policy sets (provider, model, base URL, and the key when the secrets file delivers one). Notification settings stay the user's.</string>
      <string id="ProtectionEnabled">Turn agentic protection on</string>
      <string id="ProtectionEnabled_Help">Turns on the Assistant, attack pattern detection and divergence detection (the app's protection switch).</string>
      <string id="LockProtection">Lock protection</string>
      <string id="LockProtection_Help">The user cannot change protection or the Assistant level away from the values this policy sets.</string>
      <string id="NetworkMonitoringConsent">Organization consent for network monitoring</string>
      <string id="NetworkMonitoringConsent_Help">The organization consents to LAN scanning on behalf of the user (every network the device joins). The app still shows the user a notice of what the organization turned on.</string>
      <string id="HubEmailSource">Hub account source</string>
      <string id="HubEmailSource_Help">upn: use the signed-in Windows user's UPN as the Hub account (Entra ID / AD joined devices).</string>
      <string id="HubEmailSource_upn">Signed-in user UPN</string>
      <string id="HubEmailSource_policy">HubEmail policy value</string>
      <string id="LLMProvider">LLM provider</string>
      <string id="LLMProvider_Help">LLM used by the Assistant and detection adjudication. The API key is delivered in the managed secrets file, not in policy.</string>
      <string id="LLMProvider_portal">EDAMAME Portal</string>
      <string id="LLMProvider_claude">Anthropic Claude</string>
      <string id="LLMProvider_openai">OpenAI</string>
      <string id="LLMProvider_ollama">Ollama</string>
      <string id="LLMProvider_none">None</string>
      <string id="AssistantLevel">Assistant level</string>
      <string id="AssistantLevel_Help">review: the Assistant proposes, the user confirms. auto: the Assistant applies low-risk remediations.</string>
      <string id="AssistantLevel_review">Review</string>
      <string id="AssistantLevel_auto">Auto</string>
      <string id="ShareAIFailureDetails">Share AI failure details with the Hub</string>
      <string id="ShareAIFailureDetails_Help">Enabled: the organization consents to AI failure details being added to score reports. Disabled: they are never shared. Not configured: the user decides. The user cannot change a configured value.</string>
      <string id="CaptureEnabled">Session capture</string>
      <string id="CaptureEnabled_Help">Starts (enabled) or stops (disabled) network session capture. Needs the EDAMAME Helper.</string>
      <string id="FileMonitorEnabled">File event monitoring</string>
      <string id="FileMonitorEnabled_Help">Starts (enabled) or stops (disabled) file event monitoring. Needs the EDAMAME Helper.</string>
      <string id="LanAutoScan">Automatic LAN scanning</string>
      <string id="LanAutoScan_Help">Turns automatic scanning of local networks on (enabled) or off (disabled). It scans only the networks with LAN consent: the user's, or Organization consent for network monitoring.</string>
      <string id="LockMonitoring">Lock session capture, file monitoring and LAN scanning</string>
      <string id="LockMonitoring_Help">The user cannot change session capture, file event monitoring or automatic LAN scanning away from the values set above, and turning protection off leaves them running.</string>
      <string id="HideAISettings">Hide the AI model settings</string>
      <string id="HideAISettings_Help">Hides the model connection section of Config > AI.</string>
    </stringTable>
    <presentationTable>
      <presentation id="OrganizationName">
        <textBox refId="OrganizationName">
          <label>Organization name</label>
        </textBox>
      </presentation>
      <presentation id="HubEmail">
        <textBox refId="HubEmail">
          <label>EDAMAME Hub account</label>
        </textBox>
      </presentation>
      <presentation id="LLMModel">
        <textBox refId="LLMModel">
          <label>LLM model</label>
        </textBox>
      </presentation>
      <presentation id="LLMBaseURL">
        <textBox refId="LLMBaseURL">
          <label>LLM base URL</label>
        </textBox>
      </presentation>
      <presentation id="HubEmailSource">
        <dropdownList refId="HubEmailSource" noSort="true">Hub account source</dropdownList>
      </presentation>
      <presentation id="LLMProvider">
        <dropdownList refId="LLMProvider" noSort="true">LLM provider</dropdownList>
      </presentation>
      <presentation id="AssistantLevel">
        <dropdownList refId="AssistantLevel" noSort="true">Assistant level</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
