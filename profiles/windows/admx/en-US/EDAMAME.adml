<?xml version="1.0" encoding="utf-8"?>
<!-- PROPOSED - NOT READ BY ANY RELEASED EDAMAME VERSION. Requires EDAMAME >= 2.1 (proposed). -->
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>EDAMAME Security</displayName>
  <description>Managed settings for the EDAMAME Security app (proposed).</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_EDAMAME_2_1">EDAMAME Security 2.1 or later (proposed)</string>
      <string id="EDAMAME">EDAMAME</string>
      <string id="EDAMAMESecurity">EDAMAME Security</string>
      <string id="OrganizationName">Organization name</string>
      <string id="OrganizationName_Help">Name shown in the app's &quot;Managed by your organization&quot; banner.</string>
      <string id="HubEmail">EDAMAME Hub account</string>
      <string id="HubEmail_Help">Hub account as user@domain. Use HubEmailSource=upn instead when every device should enroll with the signed-in user's UPN.</string>
      <string id="LLMModel">LLM model</string>
      <string id="LLMModel_Help">Model for Claude, OpenAI or Ollama. Ignored for the EDAMAME Portal.</string>
      <string id="LLMBaseURL">LLM base URL</string>
      <string id="LLMBaseURL_Help">Ollama URL, or an API base URL for Claude / OpenAI.</string>
      <string id="LockHubEnrollment">Lock Hub enrollment</string>
      <string id="LockHubEnrollment_Help">The user cannot change or disconnect the Hub account.</string>
      <string id="LockLLM">Lock LLM configuration</string>
      <string id="LockLLM_Help">The user cannot change the LLM provider, model or key.</string>
      <string id="ProtectionEnabled">Turn agentic protection on</string>
      <string id="ProtectionEnabled_Help">Turns on the Assistant, attack pattern detection and divergence detection (the app's protection switch).</string>
      <string id="LockProtection">Lock protection</string>
      <string id="LockProtection_Help">The user cannot turn protection off.</string>
      <string id="NetworkMonitoringConsent">Organization consent for network monitoring</string>
      <string id="NetworkMonitoringConsent_Help">The organization consents to LAN scanning and traffic capture on behalf of the user. The app still shows the user what is collected.</string>
      <string id="HubEmailSource">Hub account source</string>
      <string id="HubEmailSource_Help">upn: use the signed-in Windows user's UPN as the Hub account (Entra ID / AD joined devices).</string>
      <string id="HubEmailSource_upn">Signed-in user UPN</string>
      <string id="HubEmailSource_policy">HubEmail policy value</string>
      <string id="LLMProvider">LLM provider</string>
      <string id="LLMProvider_Help">LLM used by the Assistant and detection adjudication. The API key is delivered in the managed secrets file, not in policy.</string>
      <string id="LLMProvider_portal">EDAMAME Portal</string>
      <string id="LLMProvider_claude">Anthropic Claude</string>
      <string id="LLMProvider_openai">OpenAI</string>
      <string id="LLMProvider_ollama">Ollama</string>
      <string id="LLMProvider_none">None</string>
      <string id="AssistantLevel">Assistant level</string>
      <string id="AssistantLevel_Help">review: the Assistant proposes, the user confirms. auto: the Assistant applies low-risk remediations.</string>
      <string id="AssistantLevel_review">Review</string>
      <string id="AssistantLevel_auto">Auto</string>
    </stringTable>
    <presentationTable>
      <presentation id="OrganizationName">
        <textBox refId="OrganizationName">
          <label>Organization name</label>
        </textBox>
      </presentation>
      <presentation id="HubEmail">
        <textBox refId="HubEmail">
          <label>EDAMAME Hub account</label>
        </textBox>
      </presentation>
      <presentation id="LLMModel">
        <textBox refId="LLMModel">
          <label>LLM model</label>
        </textBox>
      </presentation>
      <presentation id="LLMBaseURL">
        <textBox refId="LLMBaseURL">
          <label>LLM base URL</label>
        </textBox>
      </presentation>
      <presentation id="HubEmailSource">
        <dropdownList refId="HubEmailSource" noSort="true">Hub account source</dropdownList>
      </presentation>
      <presentation id="LLMProvider">
        <dropdownList refId="LLMProvider" noSort="true">LLM provider</dropdownList>
      </presentation>
      <presentation id="AssistantLevel">
        <dropdownList refId="AssistantLevel" noSort="true">Assistant level</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
