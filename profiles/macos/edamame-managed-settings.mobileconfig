<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Managed settings for the EDAMAME Security app. Requires EDAMAME >= 2.0.2.
  Preference domain = the app's bundle identifier, com.edamametechnologies.edamame.
  The app reads only forced (profile-delivered) values; device or user scope.

  Secrets (Hub PIN, LLM / Portal API key) are deliberately NOT keys of this
  profile: managed preferences are readable by local users. Deploy them in
  /Library/Application Support/EDAMAME/Managed/secrets.json (root:wheel 0600),
  read by the EDAMAME Helper (see docs/app-configuration.md).

  HubEmail accepts MDM variables, e.g. Jamf $EMAIL or Intune {{mail}}.
  Remove the keys you do not want to manage: an absent key is left to the user.
-->
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>EDAMAME Security - Managed Settings</string>
    <key>PayloadIdentifier</key>
    <string>com.edamametechnologies.mdm.managed-settings</string>
    <key>PayloadOrganization</key>
    <string>Example Corp</string>
    <key>PayloadScope</key>
    <string>System</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>A5008E01-95BA-4870-BB78-E1C099A9162A</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadDisplayName</key>
            <string>EDAMAME Security</string>
            <key>PayloadIdentifier</key>
            <string>com.edamametechnologies.mdm.managed-settings.app</string>
            <key>PayloadType</key>
            <string>com.edamametechnologies.edamame</string>
            <key>PayloadUUID</key>
            <string>120AEF56-7135-4BCC-823F-671D91317BB3</string>
            <key>PayloadVersion</key>
            <integer>1</integer>

            <key>OrganizationName</key>
            <string>Example Corp</string>

            <key>HubEmail</key>
            <string>$EMAIL</string>
            <key>LockHubEnrollment</key>
            <true/>

            <key>LLMProvider</key>
            <string>portal</string>
            <key>LLMModel</key>
            <string></string>
            <key>LLMBaseURL</key>
            <string></string>
            <key>LockLLM</key>
            <true/>

            <key>ProtectionEnabled</key>
            <true/>
            <key>AssistantLevel</key>
            <string>review</string>
            <key>LockProtection</key>
            <true/>

            <key>NetworkMonitoringConsent</key>
            <true/>

            <key>ShareAIFailureDetails</key>
            <true/>

            <key>CaptureEnabled</key>
            <true/>
            <key>FileMonitorEnabled</key>
            <true/>
            <key>LockMonitoring</key>
            <false/>

            <key>HideAISettings</key>
            <false/>
        </dict>
    </array>
</dict>
</plist>
